<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="anchor" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agenda.CriacontaController">
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Painel central com altura flexível, cantos arredondados e borda suave -->
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="480.0" spacing="22.0" style="-fx-background-color: #1a1a1a; -fx-border-color: #333333; -fx-border-width: 1px; -fx-background-radius: 12px; -fx-border-radius: 12px;" StackPane.alignment="CENTER">
               <padding>
                  <Insets bottom="45.0" left="40.0" right="40.0" top="40.0" />
               </padding>
               <children>
                  <!-- Título com sua fonte e tamanhos antigos -->
                  <Label text="Crie uma conta" textFill="WHITE">
                     <font>
                        <Font size="29.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </Label>
                  
                  <!-- Campos de Entrada (Todos padronizados para largura de 310px) -->
                  <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="4.0">
                     <children>
                        <TextField fx:id="campoNome" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="310.0" promptText="Nome" style="-fx-background-color: transparent; -fx-border-color: transparent transparent white transparent; -fx-border-width: 1px; -fx-text-inner-color: white; -fx-font-size: 14px;" />
                        <Label fx:id="erroNome" text="Erro no nome" textFill="#ff4d4d" visible="false">
                           <font><Font size="11.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="4.0">
                     <children>
                        <TextField fx:id="campoEmail" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="310.0" promptText="Email" style="-fx-background-color: transparent; -fx-border-color: transparent transparent white transparent; -fx-border-width: 1px; -fx-text-inner-color: white; -fx-font-size: 14px;" />
                        <Label fx:id="erroEmail" text="Erro no email" textFill="#ff4d4d" visible="false">
                           <font><Font size="11.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="4.0">
                     <children>
                        <TextField fx:id="campoTelefone" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="310.0" promptText="Telefone" style="-fx-background-color: transparent; -fx-border-color: transparent transparent white transparent; -fx-border-width: 1px; -fx-text-inner-color: white; -fx-font-size: 14px;" />
                        <Label fx:id="erroTelefone" text="Erro no telefone" textFill="#ff4d4d" visible="false">
                           <font><Font size="11.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="4.0">
                     <children>
                        <PasswordField fx:id="campoSenha" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="310.0" promptText="Senha" style="-fx-background-color: transparent; -fx-border-color: transparent transparent white transparent; -fx-border-width: 1px; -fx-text-inner-color: white; -fx-font-size: 14px;" />
                        <Label fx:id="erroSenha" text="Erro na senha" textFill="#ff4d4d" visible="false">
                           <font><Font size="11.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="4.0">
                     <children>
                        <PasswordField fx:id="campoconfirmaSenha" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="35.0" prefWidth="310.0" promptText="Confirmar senha" style="-fx-background-color: transparent; -fx-border-color: transparent transparent white transparent; -fx-border-width: 1px; -fx-text-inner-color: white; -fx-font-size: 14px;" />
                        <Label fx:id="erroconfirmaSenha" text="Erro na confirmação" textFill="#ff4d4d" visible="false">
                           <font><Font size="11.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  
                  <!-- Área do Botão de Cadastro (Alinhado com a mesma largura de 310px) -->
                  <VBox alignment="CENTER" spacing="8.0">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <children>
                        <Button maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#aoClicarbotaoCadastrar" prefHeight="32.0" prefWidth="156.0" style="-fx-background-color: #333333; -fx-background-radius: 4px; -fx-font-size: 14px; -fx-text-fill: #e8e8e8; -fx-border-color: #555555; -fx-border-radius: 4px;" text="Criar">
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                        <Label fx:id="confirmaCadastro" alignment="CENTER" maxWidth="1.7976931348623157E308" text="Cadastro confirmado!" textFill="#2ecc71" visible="false">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
      
      <!-- Botão Voltar -->
      <Button fx:id="botaoVoltar" mnemonicParsing="false" onAction="#aoClicarBotaoVoltar" prefHeight="47.0" prefWidth="63.0" style="-fx-background-color: transparent; -fx-cursor: hand;" AnchorPane.leftAnchor="15.0" AnchorPane.topAnchor="15.0">
         <graphic>
            <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../imagens_agenda/line_start_arrow_41dp_WHITE_FILL1_wght500_GRAD200_opsz40.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
   </children>
</AnchorPane>
